# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*$py.class

# ─── Build / distribution ─────────────────────────────────────────────────────
build/
dist/
wheels/
*.egg-info/
*.egg
MANIFEST

# ─── Virtual environments ─────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ─── Environment / secrets ────────────────────────────────────────────────────
.env
.env.*
!.env.example        # allow a sample env file if you add one

# ─── Database ─────────────────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ─── Testing & coverage ───────────────────────────────────────────────────────
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# ─── Type checking ────────────────────────────────────────────────────────────
.mypy_cache/
.pyright/
.dmypy.json
dmypy.json

# ─── Linting / formatting ─────────────────────────────────────────────────────
.ruff_cache/

# ─── IDEs & editors ───────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# ─── OS generated ─────────────────────────────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/

# ─── uv ───────────────────────────────────────────────────────────────────────
# Keep uv.lock committed (reproducible installs), but ignore uv's cache
.uv/